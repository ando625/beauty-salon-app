# backend/Dockerfile
# NestJSをDockerで動かすための設計書

# ================================
# ベースイメージ
# ================================
FROM node:20-alpine
# ↑「Node.js 20のalpine（軽量Linux）版を土台にして」
# alpineにするとイメージサイズが小さくなる

# ================================
# 作業ディレクトリの設定
# ================================
WORKDIR /app
# ↑「コンテナの中の /app フォルダで作業してね」
# 「cd /app」と同じ意味
# これ以降のコマンドは全部 /app の中で実行される

# ================================
# package.jsonを先にコピー
# ================================
COPY package*.json ./
# ↑「package.jsonとpackage-lock.jsonを/appにコピーして」
# 「*」= package.json と package-lock.json 両方という意味
# なぜ先にコピーするか↓

# ================================
# 依存パッケージをインストール
# ================================
RUN npm install
# ↑「npm installを実行してライブラリを全部入れて」
# package.jsonより先にこれを実行すると
# コードを変更してもキャッシュが効いて速くなる！

# ================================
# ソースコードをコピー
# ================================
COPY . .
# ↑「残りの全ファイルを /app にコピーして」
# 「COPY コピー元 コピー先」
# 左の「.」= backendフォルダの中身全部
# 右の「.」= コンテナの /app（WORKDIRで設定した場所）

# ================================
# ポートを開放
# ================================
EXPOSE 3001
# ↑「このコンテナは3001番ポートを使いますよ」という宣言
# docker-compose.ymlのportsと合わせる

# ================================
# 起動コマンド
# ================================
CMD ["npm", "run", "start:dev"]
# ↑「コンテナ起動時にこのコマンドを実行して」
# 「npm run start:dev」= 開発モードで起動（ファイル変更で自動再起動）
# 配列形式で書くのがDockerのルール